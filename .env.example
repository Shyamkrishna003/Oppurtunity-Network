# Local development values only. Copy to .env; never reuse these in production.

# Port on the host where Nginx serves the whole application.
HTTP_PORT=8080

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-only-not-a-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
# The backend is only reachable through Nginx, which sets X-Real-IP.
TRUST_PROXY_HEADERS=true

POSTGRES_DB=opportunity_network
POSTGRES_USER=opportunity
POSTGRES_PASSWORD=opportunity-dev
DATABASE_URL=postgres://opportunity:opportunity-dev@postgres:5432/opportunity_network

REDIS_CACHE_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CHANNEL_REDIS_URL=redis://redis:6379/2

# Mailpit captures all outgoing mail; inbox at http://localhost:8025
EMAIL_HOST=mailpit
EMAIL_PORT=1025
