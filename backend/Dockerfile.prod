# The production image: runtime dependencies only, the code baked in, nothing mounted.
# Development uses ./Dockerfile, which also installs the test and lint tools.
FROM python:3.14-slim

COPY --from=ghcr.io/astral-sh/uv:0.12.19 /uv /bin/uv

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    DJANGO_SETTINGS_MODULE=config.settings.prod

# Uploaded files and collected static files live in volumes; they must exist, owned by the
# unprivileged user, before a volume is first mounted over them.
RUN useradd --create-home --uid 1000 app \
    && mkdir -p /opt/venv /data/media /data/private_media /data/static \
    && chown -R app:app /opt/venv /data
WORKDIR /app
USER app

COPY --chown=app:app pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

COPY --chown=app:app . .

ENV MEDIA_ROOT=/data/media \
    PRIVATE_MEDIA_ROOT=/data/private_media \
    STATIC_ROOT=/data/static

EXPOSE 8000
# One ASGI server for HTTP and WebSocket. Run more containers to serve more.
CMD ["daphne", "--bind", "0.0.0.0", "--port", "8000", "--proxy-headers", "config.asgi:application"]
