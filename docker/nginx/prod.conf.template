# Rendered at container start: ${SERVER_NAME} is replaced from the environment. Nginx's own
# variables ($uri and the like) are left alone, since only defined environment variables
# are substituted.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# WebSocket URLs carry single-use tickets in the query string; keep them out of logs.
log_format without_query '$remote_addr [$time_local] "$request_method $uri" $status $request_id';

# Per address. The application has finer limits per account and per action; these stop a
# flood before it reaches the application at all, signed in or not.
limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=perip:10m;
limit_req_status 429;
limit_conn_status 429;

upstream backend {
    server backend:8000;
    keepalive 16;
}

server {
    listen 80;
    server_name ${SERVER_NAME};

    # For the container's own health check, which has no certificate to trust.
    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    server_tokens off;
    client_max_body_size 10m;
    limit_conn perip 40;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header Connection "";
    # Always overwritten here, never passed on from the client: the application trusts
    # these for the visitor's address, the scheme, and the request ID.
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Request-ID $request_id;

    # The application sets its own security headers on what it answers.
    location ~ ^/(api|admin)/ {
        limit_req zone=api burst=40 nodelay;
        proxy_pass http://backend;
    }

    location ~ ^/(healthz|readyz)$ {
        proxy_pass http://backend;
        access_log off;
    }

    # A location that sets any proxy header stops inheriting the server-level ones, so the
    # full set is repeated.
    location /ws/ {
        proxy_pass http://backend;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 120s;
        access_log /var/log/nginx/access.log without_query;
    }

    # Django's own static files (the admin), collected into a volume at deploy.
    location /static/ {
        alias /srv/static/;
        expires 7d;
        add_header X-Content-Type-Options nosniff always;
    }

    # Files people uploaded (avatars, logos). Never a page, whatever they contain.
    location /media/ {
        alias /srv/media/;
        expires 1h;
        add_header X-Content-Type-Options nosniff always;
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; sandbox" always;
    }

    # Everything else is the web app. add_header is not inherited once a location sets its
    # own, so the full set is included in each.
    root /usr/share/nginx/html;

    # Built files have a hash in their name: they never change, so cache them for good.
    location /assets/ {
        include /etc/nginx/snippets/app-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # The page itself must always be fresh, or a deploy would not reach open browsers.
    location / {
        include /etc/nginx/snippets/app-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
