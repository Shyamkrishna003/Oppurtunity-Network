# Production configuration. Copy to .env.production and replace every CHANGE_ME.
# Never commit the filled-in file. The application refuses to start with unsafe values.

# The public host name, without scheme. The certificate in TLS_CERT_DIR must be for it.
SERVER_NAME=opportunity.example.com
# Directory holding fullchain.pem and privkey.pem.
TLS_CERT_DIR=./certs
HTTP_PORT=80
HTTPS_PORT=443
# Tag for the images built from this checkout, such as a git commit.
APP_VERSION=latest

DJANGO_SETTINGS_MODULE=config.settings.prod
# At least 50 random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_ALLOWED_HOSTS=opportunity.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://opportunity.example.com
# The backend is only reachable through Nginx, which sets X-Real-IP.
TRUST_PROXY_HEADERS=true
# Origin of the web app, used in emailed links.
FRONTEND_URL=https://opportunity.example.com

# The database owner: used only to create the database and run migrations.
POSTGRES_DB=opportunity_network
POSTGRES_USER=opportunity_owner
POSTGRES_PASSWORD=CHANGE_ME
# What the running application connects as: rows only, no changes to structure.
# Created when the database volume is first initialised.
APP_DB_USER=opportunity_app
APP_DB_PASSWORD=CHANGE_ME
# Must repeat APP_DB_USER, APP_DB_PASSWORD and POSTGRES_DB. Passwords with characters
# special in URLs (@ : / ? #) must be percent-encoded here.
DATABASE_URL=postgres://opportunity_app:CHANGE_ME@postgres:5432/opportunity_network

REDIS_CACHE_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CHANNEL_REDIS_URL=redis://redis:6379/2

# Your mail provider's SMTP service.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_ME
EMAIL_HOST_PASSWORD=CHANGE_ME
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@opportunity.example.com
